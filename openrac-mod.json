{
  "format": 2,
  "id": "aprac2-openrac-dev",
  "name": "ArchipelagoRAC2",
  "version": "0.5.0",
  "author": "ArchipelagoRAC2 contributors; based on APRac2 by evilwb / Will Becker",
  "description": "Experimental Archipelago multiworld for Going Commando USA v1.01 and Locked & Loaded PAL. Gameplay decisions run in the mod using OpenRAC API 1.40 queries; no private host overrides or activation bytes. Based on evilwb/APRac2.",
  "license": "MIT",
  "api": "1.40",
  "games": {
    "rac2": [
      "ntsc",
      "pal"
    ]
  },
  "hooks": [
    "Item_Give",
    "Item_Equip",
    "Planet_Unlock",
    "PlatinumBolts_CountTotal",
    "Hero_UpdateCollectionProgress",
    "Save_Serialize",
    "Save_NewGame",
    "Moby_CountKill",
    "Weapon_LevelUp",
    "Vendor_BuildList",
    "Vendor_Price",
    "Moby_DynamoPickup_Update",
    "Moby_TractorBeamSeller_Update",
    "Moby_BoxBreakerPickup_Update",
    "Moby_ThermanatorSeller_Update",
    "Moby_ThermanatorArea_Update",
    "Moby_SwingshotArea_Update",
    "Moby_GliderPickup_Update",
    "Moby_LevitatorSeller_Update",
    "Moby_ChargeBootsRider_Update",
    "Moby_RaceController_Update",
    "Moby_MapperReturn_Update",
    "Moby_HypnomaticMaker_Update",
    "Moby_EndakoRescue_Update",
    "Moby_TaboraWrench_Update",
    "Moby_PrisonWrench_Init",
    "Moby_TodanoTrader_Update",
    "Moby_PrisonPlumber_Update",
    "Moby_PrisonController_Update",
    "Moby_SiberiusThief_Update",
    "Moby_BoldanCutscene_Update",
    "Moby_HypnomaticPart_Update"
  ],
  "settings": [
    {
      "key": "enable_gameplay",
      "name": "Experimental native gameplay",
      "type": "bool",
      "default": false,
      "description": "Requires the OpenRAC gameplay-query API 1.40 integration. Full campaigns remain experimental."
    },
    {
      "key": "bridge_port",
      "name": "Local client port",
      "type": "int",
      "default": 38282,
      "min": 1,
      "max": 65535
    },
    {
      "key": "bridge_token",
      "name": "Local client token",
      "type": "string",
      "default": "",
      "description": "Paste the token printed by the ArchipelagoRAC2 sidecar console."
    }
  ]
}
